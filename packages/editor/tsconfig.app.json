{
  "extends": "@workspace/typescript-config/react.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    // 保留 TS 5.9 的检查行为；严格模式另行迁移。
    "strict": false,
    "noUncheckedSideEffectImports": false,
    "paths": {
      // "@/*": ["./src/*"],
      "@workspace/editor/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["src/components/tiptap-ui/**/*", "src/page/components/ai/**/*"]
}
