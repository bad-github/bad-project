{
  "name": "@workspace/editor",
  "version": "1.0.0",
  "type": "module",
  "source": "src/index.tsx",
  "output": "dist-lib",
  "main": "dist-lib/umd/index.cjs",
  "module": "dist-lib/esm/index.mjs",
  "types": "dist-lib/types/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./editor.css": "./dist-lib/editor.css",
    ".": {
      "types": "./dist-lib/types/index.d.ts",
      "import": "./dist-lib/esm/index.mjs",
      "require": "./dist-lib/umd/index.cjs",
      "default": "./dist-lib/esm/index.mjs"
    }
  },
  "files": [
    "dist-lib"
  ],
  "scripts": {
    "dev": "vite",
    "build:lib": "tsc -b && vite build --config vite.esm.config.ts && vite build --config vite.umd.config.ts",
    "build:app": "tsc -b && vite build --config vite.config.ts",
    "build": "pnpm run build:lib",
    "prepack": "pnpm run build:lib",
    "lint": "eslint .",
    "lint:quiet": "eslint . --quiet",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@ariakit/react": "^0.4.25",
    "@base-ui/react": "^1.3.0",
    "@floating-ui/react": "^0.27.19",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@tiptap/core": "^3.22.5",
    "@tiptap/extension-audio": "^3.22.5",
    "@tiptap/extension-blockquote": "^3.22.5",
    "@tiptap/extension-bold": "^3.22.5",
    "@tiptap/extension-code": "^3.22.5",
    "@tiptap/extension-code-block": "^3.22.5",
    "@tiptap/extension-code-block-lowlight": "^3.22.5",
    "@tiptap/extension-color": "^3.22.5",
    "@tiptap/extension-details": "^3.22.5",
    "@tiptap/extension-document": "^3.22.5",
    "@tiptap/extension-drag-handle-react": "^3.22.5",
    "@tiptap/extension-emoji": "^3.22.5",
    "@tiptap/extension-hard-break": "^3.22.5",
    "@tiptap/extension-heading": "^3.22.5",
    "@tiptap/extension-highlight": "^3.22.5",
    "@tiptap/extension-horizontal-rule": "^3.22.5",
    "@tiptap/extension-image": "^3.22.5",
    "@tiptap/extension-italic": "^3.22.5",
    "@tiptap/extension-link": "^3.22.5",
    "@tiptap/extension-list": "^3.22.5",
    "@tiptap/extension-mathematics": "^3.22.5",
    "@tiptap/extension-mention": "^3.22.5",
    "@tiptap/extension-paragraph": "^3.22.5",
    "@tiptap/extension-strike": "^3.22.5",
    "@tiptap/extension-subscript": "^3.22.5",
    "@tiptap/extension-superscript": "^3.22.5",
    "@tiptap/extension-table": "^3.22.5",
    "@tiptap/extension-table-of-contents": "^3.22.5",
    "@tiptap/extension-text": "^3.22.5",
    "@tiptap/extension-text-align": "^3.22.5",
    "@tiptap/extension-text-style": "^3.22.5",
    "@tiptap/extension-twitch": "^3.22.5",
    "@tiptap/extension-underline": "^3.22.5",
    "@tiptap/extension-unique-id": "^3.22.5",
    "@tiptap/extension-youtube": "^3.22.5",
    "@tiptap/extensions": "^3.22.5",
    "@tiptap/pm": "^3.22.5",
    "@tiptap/react": "^3.22.5",
    "@tiptap/suggestion": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.4",
    "class-variance-authority": "^0.7.1",
    "highlight.js": "^11.11.1",
    "is-hotkey": "^0.2.0",
    "katex": "^0.16.45",
    "lowlight": "^3.3.0",
    "react-hotkeys-hook": "^5.2.4",
    "react-textarea-autosize": "^8.5.9"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.2",
    "@types/is-hotkey": "^0.1.10",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/vitest-config": "workspace:*",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "eslint": "^10.2.1",
    "sass-embedded": "^1.99.0",
    "typescript": "6.0.3",
    "vite": "^8.0.4",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
